10 SCREEN 1 '디스플레이모드 40X24 chars / 16 colors
20 WIDTH 31
30 KEYOFF
40 DIM XX(4,4),YY(4,4),NB(4,4)
50 ' Init Random seed
60 GET TIME TM$:SD=VAL(MID$(TM$,7,2))*VAL(MID$(TM$,4,2))*VAL(MID$(TM$,1,2))
70 GET DATE DT$:SD=SD+VAL(MID$(DT$,7,2))*VAL(MID$(DT$,4,2))*VAL(MID$(DT$,1,2))
80 RD=RND(-SD)
100 '
110 OC$="!@#$^&*("
120 FOR OI=1 TO 8
130  AC=ASC(MID$(OC$,OI,1))
140  FOR I=0 TO 7
150   READ D$:VPOKE AC*8+I,VAL("&B"+D$)
160  NEXT I
170 NEXT OI
180 ET = 0
190 IV=(60-10*(PEEK(&H2B)\128))/10
200 ON INTERVAL=IV GOSUB 300
210 INTERVAL ON
220 GOTO 500
230 GOTO 12000 'Go To End
300 ' 
310 ' Count up elapsed frame
320 ET=ET+1
330 'LOCATE 0,0:PRINT ET;
340 RETURN
500 '
510 ' Main Loop
520 'ST(Status)
530 '1 = TITLE INIT
540 '2 = TITLE SCENE
550 '3 = PRESS PRESS TO START, INIT
560 '4 = PRESS PRESS TO START
570 '5 = MAIN GAME INIT
580 '6 = MAIN GAME
590 '7 = Show clear message
600 '8 = Congratulations!
610 ST=1
620 ON ST GOSUB 700,1000,1500,2000,2500,3000,3500,4000
630 GOTO 620
700 '
710 '
720 ' Title init
730 CLS
740 TT$="SLIDING PUZZLE"
750 TX = 30	'title x pos
760 TI=1 'title string index
770 TS$ = MID$(TT$,TI,1)
780 ST=2
1000 '
1010 ' Title
1020 ' 타이틀을 1문자씩 추가하면서 미끄러지게 한다
1030 ' 화면 중앙까지 미끄러지게 한다 
1040 IF ET = 0 THEN RETURN
1050 FOR I=1 TO ET
1060	TX=TX-1
1070	IF TI < 14 THEN TI=TI+1:TS$=TS$+MID$(TT$,TI,1) ELSE TS$=TS$+" "
1080 NEXT I
1090 ET=0
1100 LOCATE TX,9:PRINT TS$;
1110 IF TX=8 THEN ST=3
1120 RETURN
1500 '
1510 ' PRESS SPACE TO START, INIT
1520 ON STRIG GOSUB 2070
1530 STRIG(0) ON
1540 ST=4
2000 '
2010 ' PRESS SPACE TO START
2020 LOCATE 5,14
2030 IF ET=7 THEN PRINT "PRESS SPACE TO START";
2040 IF ET=13 THEN PRINT "                    ";
2050 IF ET>13 THEN ET=ET-14
2060 RETURN
2070 STRIG(1) OFF
2080 ST=5
2090 CLS
2100 RETURN
2500 '
2510 ' MAIN GAME INIT
2520 LOCATE 11,12:PRINT "PREPARING";:LOCATE 11,14:PRINT "THE PUZZLE";
2530 II=0
2540 FOR Y=0 TO 4
2550  FOR X=0 TO 4
2560   XX(Y,X)=5+X*4:YY(Y,X)=4+Y*4:NB(Y,X)=II+1
2570   II=II+1
2580  NEXT X
2590 NEXT Y
2600 NB(4,4)=-1:EX=4:EY=4 'Empty tile's position
2610 GOSUB 8010
2620 FOR Y=0 TO 4
2630  FOR X=0 TO 4
2640   TX=XX(Y,X):TY=YY(Y,X):TN=NB(Y,X)
2650	GOSUB 7510
2660  NEXT X
2670 NEXT Y
2680 ST=6
2690 LC=0 'Last Cursor Status
2700 MV=0 'Init move count
2710 CT=0 'Complete flag
3000 '
3010 ' Main Game
3020 ' Wait for cursor key
3030 'LOCATE 0,0:PRINT USING "## ##";EX;EY;
3040 LOCATE 8,0:PRINT "MOVE COUNT ";MV;
3050 CS=STICK(0)
3060 'LOCATE 0,0:PRINT USING "# #";LC;CS;
3070 IF CS=LC THEN CS=0 ELSE LC=CS 'Prevent key repetition
3080 MX=EX:MY=EY
3090 IF MY=0 THEN ON (MX+1) GOSUB 4500,4700,4700,4700,4600 ELSE IF MY=4 THEN ON (MX+1) GOSUB 5100,5300,5300,5300,5200 ELSE ON(MX+1) GOSUB 4800,4900,4900,4900,5000
3100 IF CT=0 THEN RETURN
3110 ST=7
3500 '
3510 ' Show clear message
3520 LOCATE 3,1:PRINT "YOU FINISHED THE PUZZLE.";:LOCATE 7,2:PRINT "CONGRATULATIONS";
3530 PLAY "GGAAGGE2GEDEC2","C2F2C2C2C2O3A2O4C2"
3540 ST=8
3550 WT=0
3560 ET=0
4000 '
4010 ' Congratulations
4020 WT=WT+ET
4030 ET=0
4040 IF WT>=70 THEN ST=1
4050 RETURN
4500 '
4510 'at Left Top
4520 'it can move right(left key) or down(up key)
4530 'LOCATE 0,1:PRINT "LT"
4540 IF CS=7 THEN GOSUB 6200 ELSE IF CS=1 THEN GOSUB 6600
4550 RETURN
4600 '
4610 'at Right Top
4620 'it can move left(right key) or down(up key)
4630 'LOCATE 0,1:PRINT "RT"
4640 IF CS=3 THEN GOSUB 6000 ELSE IF CS=1 THEN GOSUB 6600
4650 RETURN
4700 '
4710 'at Top
4720 'it can move left(right key), right(left key) or down(up key)
4730 'LOCATE 0,1:PRINT "T"
4740 IF CS=3 THEN GOSUB 6000 ELSE IF CS=7 THEN GOSUB 6200 ELSE IF CS=1 THEN GOSUB 6600
4750 RETURN
4800 '
4810 'at Left
4820 'it can move up(down key), down(up key) or right(left key)
4830 'LOCATE 0,1:PRINT "L"
4840 IF CS=1 THEN GOSUB 6600 ELSE IF CS=5 THEN GOSUB 6400 ELSE IF CS=7 THEN GOSUB 6200
4850 RETURN
4900 '
4910 'at Mid
4920 'it can move left(right key), right(left key), up(down key) or down(up key)
4930 'LOCATE 0,1:PRINT "M";
4940 IF CS=1 THEN GOSUB 6600 ELSE IF CS=5 THEN GOSUB 6400 ELSE IF CS=7 THEN GOSUB 6200 ELSE IF CS=3 THEN GOSUB 6000
4950 RETURN
5000 '
5010 'at Right
5020 'it can move up(down key), down(up key) or left(right key)
5030 'LOCATE 0,1:PRINT "R"
5040 IF CS=1 THEN GOSUB 6600 ELSE IF CS=5 THEN GOSUB 6400 ELSE IF CS=3 THEN GOSUB 6000
5050 RETURN
5100 '
5110 'at Left Bottom
5120 'it can move right(left key) or up(down key)
5130 'LOCATE 0,1:PRINT "LB"
5140 IF CS=7 THEN GOSUB 6200 ELSE IF CS=5 THEN GOSUB 6400
5150 RETURN
5200 '
5210 'at Right Bottom
5220 'it can move left(right key) or up(down key)
5230 'LOCATE 0,1:PRINT "RB"
5240 IF CS=3 THEN GOSUB 6000 ELSE IF CS=5 THEN GOSUB 6400
5250 RETURN
5300 '
5310 'at Bottom
5320 'it can move left(right key), right(left key) or up(down key)
5330 'LOCATE 0,1:PRINT "B"
5340 IF CS=3 THEN GOSUB 6000 ELSE IF CS=7 THEN GOSUB 6200 ELSE IF CS=5 THEN GOSUB 6400
5350 RETURN
6000 '
6010 ' Empy piece move left
6020 'LOCATE 0,2:PRINT "4000";
6030 GOSUB 10150:MV=MV+1
6040 TN=NB(EY,EX):TX=XX(EY,EX):TY=YY(EY,EX):GOSUB 7500
6050 TN=NB(MY,MX):TX=XX(MY,MX):TY=YY(MY,MX):GOSUB 7500
6060 GOSUB 6800 'Check completetion
6070 RETURN
6200 '
6210 ' Empy piece move right
6220 'LOCATE 0,2:PRINT "4100";
6230 GOSUB 10300:MV=MV+1
6240 TN=NB(EY,EX):TX=XX(EY,EX):TY=YY(EY,EX):GOSUB 7500
6250 TN=NB(MY,MX):TX=XX(MY,MX):TY=YY(MY,MX):GOSUB 7500
6260 GOSUB 6800 'Check completetion
6270 RETURN
6400 '
6410 ' Empy piece move up
6420 'LOCATE 0,2:PRINT "4200";
6430 GOSUB 10400:MV=MV+1
6440 TN=NB(EY,EX):TX=XX(EY,EX):TY=YY(EY,EX):GOSUB 7500
6450 TN=NB(MY,MX):TX=XX(MY,MX):TY=YY(MY,MX):GOSUB 7500
6460 GOSUB 6800 'Check completetion
6470 RETURN
6600 '
6610 ' Empy piece move down
6620 'LOCATE 0,2:PRINT "4300";
6630 GOSUB 10500:MV=MV+1
6640 TN=NB(EY,EX):TX=XX(EY,EX):TY=YY(EY,EX):GOSUB 7500
6650 TN=NB(MY,MX):TX=XX(MY,MX):TY=YY(MY,MX):GOSUB 7500
6660 GOSUB 6800 'Check completetion
6670 RETURN
6800 '
6810 ' Check completion
6820 IF NB(0,0)<>1 OR NB(0,1)<>2 OR NB(0,2)<>3 OR NB(0,3)<>4 OR NB(0,4)<>5 THEN CT=0:RETURN
6830 IF NB(1,0)<>6 OR NB(1,1)<>7 OR NB(1,2)<>8 OR NB(1,3)<>9 OR NB(1,4)<>10 THEN CT=0:RETURN
6840 IF NB(2,0)<>11 OR NB(2,1)<>12 OR NB(2,2)<>13 OR NB(2,3)<>14 OR NB(2,4)<>15 THEN CT=0:RETURN
6850 IF NB(3,0)<>16 OR NB(3,1)<>17 OR NB(3,2)<>18 OR NB(3,3)<>19 OR NB(3,4)<>20 THEN CT=0:RETURN
6860 IF NB(4,0)<>21 OR NB(4,1)<>22 OR NB(4,2)<>23 OR NB(4,3)<>24 OR NB(4,4)<>-1 THEN CT=0:RETURN
6870 CT=1:RETURN
7500 '
7510 ' Draw a tile
7520 IF TN=-1 THEN FOR K=0 TO 3:LOCATE TX,TY+K:PRINT "    ";:NEXT K:RETURN
7530 LOCATE TX,TY:PRINT "!@@#";
7540 LOCATE TX,TY+1:PRINT USING "$##^";TN;
7550 LOCATE TX,TY+2:PRINT "$  ^";
7560 LOCATE TX,TY+3:PRINT "&**(";
7570 RETURN
8000 '
8010 ' Shake tiles
8020 FOR I=0 TO 200
8030  MX=EX:MY=EY
8040  IF MY=0 THEN ON (MX+1) GOSUB 8500,8900,8900,8900,8700 ELSE IF MY=4 THEN ON (MX+1) GOSUB 9700,10100,10100,10100,9900 ELSE ON(MX+1) GOSUB 9100,9300,9300,9300,9500
8050 NEXT I
8060 RETURN
8500 'at Left Top
8510 'it can move right or down
8520 RD=INT(RND(1)*2)+1
8530 ON RD GOSUB 10300, 10500
8540 RETURN
8700 'at Right Top
8710 'it can move left or down
8720 RD=INT(RND(1)*2)+1
8730 ON RD GOSUB 10150, 10500
8740 RETURN
8900 'at Top
8910 'it can move left, right or down
8920 RD=INT(RND(1)*3)+1
8930 ON RD GOSUB 10150, 10300, 10500
8940 RETURN
9100 'at Left
9110 'it can move up,down or right
9120 RD=INT(RND(1)*3)+1
9130 ON RD GOSUB 10300, 10400, 10500
9140 RETURN
9300 'at Mid
9310 'it can move left, right, up or down
9320 RD=INT(RND(1)*4)+1
9330 ON RD GOSUB 10150, 10300, 10400, 10500
9340 RETURN
9500 'at Right
9510 'it can move up, down or left
9520 RD=INT(RND(1)*3)+1
9530 ON RD GOSUB 10150, 10400, 10500
9540 RETURN
9700 'at Left Bottom
9710 'it can move right or up
9720 RD=INT(RND(1)*2)+1
9730 ON RD GOSUB 10300, 10400
9740 RETURN
9900 'at Right Bottom
9910 'it can move left or up
9920 RD=INT(RND(1)*2)+1
9930 ON RD GOSUB 10150, 10400
9940 RETURN
10100 'at Bottom
10110 'it can move left, right or up
10120 RD=INT(RND(1)*3)+1
10130 ON RD GOSUB 10150, 10300, 10400
10140 RETURN
10150 'Move left
10160 NB(EY,EX)=NB(EY,EX-1)
10170 EX=EX-1
10180 NB(EY,EX)=-1
10190 RETURN
10300 'Move Right
10310 NB(EY,EX)=NB(EY,EX+1)
10320 EX=EX+1
10330 NB(EY,EX)=-1
10340 RETURN
10400 'Move Up
10410 NB(EY,EX)=NB(EY-1,EX)
10420 EY=EY-1
10430 NB(EY,EX)=-1
10440 RETURN
10500 'Move Down
10510 NB(EY,EX)=NB(EY+1,EX)
10520 EY=EY+1
10530 NB(EY,EX)=-1
10540 RETURN
